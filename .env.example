# Postgres connection string. For Supabase use the *pooled* connection string
# (Project Settings > Database > Connection pooling, port 6543, Transaction mode).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Session signing secret: 32+ random characters. Generate with: openssl rand -base64 48
JWT_SECRET="wkFo0Ca11kVhO3O7OzKs8XwN4m2CsTSAvNHG+0PzRfKp2z7CKvfgrzK2S7DTCB0G"

# Company timezone used for "today" (IANA name)
APP_TIMEZONE="Asia/Kolkata"

# First HR admin -- only used by `npm run db:init` when no HR user exists yet
ADMIN_EMAIL="hr@yourcompany.com"
ADMIN_PASSWORD="YourStrongPassword123"
ADMIN_NAME="HR Administrator"
